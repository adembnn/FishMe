{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/*)",
      "Bash(./scripts/*)",
      "Bash(bash scripts/*)",
      "Bash(python3 outils/atelier/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git worktree *)",
      "Bash(swift test *)",
      "Bash(swift build *)",
      "Bash(swift format *)",
      "Bash(xcodebuild *)",
      "Bash(xcrun simctl *)",
      "Bash(docker run *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Edit(**/*.pbxproj)",
      "Bash(cat .env*)",
      "Bash(cat * .env*)",
      "Bash(cat */.env*)",
      "Bash(head .env*)",
      "Bash(head * .env*)",
      "Bash(head */.env*)",
      "Bash(tail .env*)",
      "Bash(tail * .env*)",
      "Bash(tail */.env*)",
      "Bash(less .env*)",
      "Bash(less * .env*)",
      "Bash(less */.env*)",
      "Bash(more .env*)",
      "Bash(more * .env*)",
      "Bash(more */.env*)",
      "Bash(grep .env*)",
      "Bash(grep * .env*)",
      "Bash(grep */.env*)",
      "Bash(rg .env*)",
      "Bash(rg * .env*)",
      "Bash(rg */.env*)",
      "Bash(awk .env*)",
      "Bash(awk * .env*)",
      "Bash(awk */.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push *:main*)",
      "Bash(git push origin master*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git push * --no-verify*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/contexte.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-lot.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/formate.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/preuve.py\"",
            "timeout": 900,
            "statusMessage": "Vérification des tests (scripts/verif.sh --rapide)…"
          }
        ]
      }
    ]
  }
}
