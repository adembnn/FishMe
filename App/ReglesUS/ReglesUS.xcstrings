    },
    "Au-dessus de la taille maximale (%@) : poisson mesuré %@": {
      "comment": "Bloc des règles US (lot US12).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over the maximum size (%1$@): fish measured %2$@"
          }
        }
      }
    },
    "Aucune interdiction connue de nous, vérifie auprès de l'agence": {
      "comment": "Bloc des règles US (lot US12).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We know of no prohibition. Check with the state agency."
          }
        }
      }
    },
    "Aucune règle lue pour ce poisson ici.": {
      "comment": "Bloc des règles US (lot US12).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No regulation read for this fish here."
